# Ports — Railway injects $PORT (single port: API + target via start.sh)
PORT=8000
TARGET_PORT=8001
# Groq free tier - https://console.groq.com/keys (14k req/day مجاني)
GROQ_API_KEY=gsk_...
# Local: اتركه فاضي = يستخدم http://127.0.0.1:8001 (isolated sandbox)
# Production Railway/Render: رابط الـ target service
# مثال Railway: TARGET_URL=https://penguard-target.up.railway.app
TARGET_URL=
# Frontend → API (Vercel أو Railway)
# مثال Railway بعد deploy الـ API انسخه هنا:
# NEXT_PUBLIC_API_BASE=https://heroic-insight-production-d97d.up.railway.app
NEXT_PUBLIC_API_BASE=https://heroic-insight-production-d97d.up.railway.app
# Backend auth — required on POST /api/episodes/run + POST /approve + DELETE /api/episodes (GET open)
# Railway Variables: PENGUARD_API_KEY=<strong-token> + Vercel: NEXT_PUBLIC_API_KEY=<same-token>
PENGUARD_API_KEY=penguard-dev-token-2026
NEXT_PUBLIC_API_KEY=penguard-dev-token-2026
# Git-Native PR (only XSS produces real PR; others pr_url=null expected)
# GITHUB_TOKEN=ghp_...
# GITHUB_TARGET_REPO=Iabdallllah/PenGuard
# Postgres (Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}; fallback sqlite:///./penguard.db)
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/railway
# SOC alerts — Discord/Slack incoming webhook (optional; fire-and-forget per completed episode)
# PENGUARD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# FinOps — LLM price per 1K tokens in USD (optional; enables estimated_cost_usd, e.g. Groq list rates)
# PENGUARD_PRICE_PER_1K_IN_USD=0.00015
# PENGUARD_PRICE_PER_1K_OUT_USD=0.0006
