# Dashboard server-side configuration (never exposes secrets to the browser).
# Copy to .env.local for local development. Do not commit real values.

# Server-only backend API credential (used by /api/proxy route handler).
PENGUARD_API_KEY=dev-local-penguard-key-change-me

# Backend origin for the server-side proxy. NEXT_PUBLIC_API_BASE remains the
# public URL used only for the direct WebSocket connection.
PENGUARD_API_BASE=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Optional proxy timeout in milliseconds (default 120000 for PDF generation).
PENGUARD_PROXY_TIMEOUT_MS=120000
